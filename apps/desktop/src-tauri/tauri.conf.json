{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ironbark Assistant",
  "version": "0.1.0",
  "identifier": "com.ironbark.assistant",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bunx vite",
    "beforeBuildCommand": "bunx vite build"
  },
  "app": {
    "windows": [
      {
        "title": "Ironbark Assistant",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self' data:",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon-512.png"],
    "targets": ["rpm", "appimage"]
  }
}
